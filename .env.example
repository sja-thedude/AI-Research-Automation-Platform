# ==========================================================================
# NeuraForge AI — Environment Configuration
# Copy to `.env` and fill in. NEVER commit the real .env file.
# ==========================================================================

# ---- Django ----
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-50-char-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000

# ---- Database (PostgreSQL + pgvector) ----
POSTGRES_DB=neuraforge
POSTGRES_USER=neuraforge
POSTGRES_PASSWORD=neuraforge
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://neuraforge:neuraforge@db:5432/neuraforge

# ---- Redis (cache + channels + celery broker) ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CHANNELS_REDIS_URL=redis://redis:6379/3

# ---- AI / LLM ----
OPENAI_API_KEY=sk-your-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIM=1536
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# ---- Vector store backend: pgvector | chroma | pinecone | weaviate ----
VECTOR_BACKEND=pgvector
CHROMA_HOST=chroma
CHROMA_PORT=8001
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
WEAVIATE_URL=

# ---- File storage: local | s3 ----
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto

# ---- Auth / JWT ----
JWT_ACCESS_TOKEN_LIFETIME_MIN=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ---- Observability ----
SENTRY_DSN=
LOG_LEVEL=INFO

# ---- Limits ----
MAX_UPLOAD_SIZE_MB=50
